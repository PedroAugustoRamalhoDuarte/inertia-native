<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>

<h1>Posts</h1>

<div id="turbo_posts">
  <% @turbo_posts.each do |turbo_post| %>
    <%= render turbo_post %>
    <p>
      <%= link_to "Show this post", turbo_post_path(turbo_post.id) %>
    </p>
  <% end %>
</div>

<%= link_to "New post", new_turbo_post_path %>
